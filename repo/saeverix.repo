# Client configuration for the Fedora packages built by this repository, served
# from GitHub Pages under the rpm.vries.cloud custom domain.
#
# The bare $releasever and $basearch are dnf's own variables and are expanded per
# client -- do not substitute them here.
[saeverix]
name=Saeverix packages for Fedora $releasever
baseurl=https://rpm.vries.cloud/fedora/$releasever/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://rpm.vries.cloud/RPM-GPG-KEY-saeverix

# Deliberately NOT skip_if_unavailable=1: this repo is publicly reachable, so an
# unreachable repo means something is actually wrong rather than "off the LAN".
# It matters most for Fedora Atomic / bootc image builds -- skipping silently
# would produce an image that is simply missing these packages, and a build that
# looks green.
skip_if_unavailable=0

# Only tags publish, so metadata changes rarely. One hour picks new packages up
# promptly without asking the CDN for repomd.xml on every transaction.
metadata_expire=1h
