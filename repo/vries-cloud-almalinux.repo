# Client configuration for the AlmaLinux packages built by this repository. See
# vries-cloud.repo for the Fedora equivalent; the notes on skip_if_unavailable and
# metadata_expire there apply here too.
#
# A separate file rather than one templated on $releasever, because the distro path
# segment is not derivable from it: $releasever is "10" on EL10 and "44" on Fedora 44,
# but the trees are /almalinux/10/ and /fedora/44/. dnf has no $distro variable.
#
# Only fish is built for AlmaLinux. Everything else is blocked on missing build
# dependencies rather than on anything in this repository -- see the Packages table in
# README.md.
[vries-cloud]
name=vries.cloud packages for AlmaLinux $releasever
baseurl=https://rpm.vries.cloud/almalinux/$releasever/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://rpm.vries.cloud/RPM-GPG-KEY-vries-cloud
skip_if_unavailable=0
metadata_expire=1h
